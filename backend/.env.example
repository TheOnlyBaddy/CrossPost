# Copy to .env and fill in. .env is gitignored.

# Where this backend is reachable FROM THE PUBLIC INTERNET.
# Instagram does not accept uploaded bytes in the container flow — it FETCHES
# the video from a URL we hand it. So for Instagram to work this must be a real
# HTTPS host Meta can reach. http://localhost:8000 is fine for YouTube and for
# local UI work, but Instagram publishes will fail until this is a public URL
# (use a Cloudflare Tunnel or ngrok in development).
PUBLIC_BASE_URL=http://localhost:8000

# Dev server origin, for CORS.
FRONTEND_ORIGIN=http://localhost:5173

# Encrypts OAuth tokens at rest. Generate one with:
#   py -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Google Cloud → APIs & Services → Credentials → OAuth 2.0 Client ID (Web application)
# Authorized redirect URI must be: <PUBLIC_BASE_URL>/api/auth/youtube/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# developers.facebook.com → your app → Settings → Basic
# Valid OAuth redirect URI must be: <PUBLIC_BASE_URL>/api/auth/meta/callback
# Meta requires HTTPS here — plain http://localhost is rejected.
META_APP_ID=
META_APP_SECRET=

# Only for apps using "Facebook Login for Business": the Configuration ID from
# the app's Facebook Login for Business settings. When set, it is sent instead
# of the scope list, because the configuration already carries the permissions.
# Leave empty for classic Facebook Login.
META_CONFIG_ID=

# "private" | "unlisted" | "public".
# Defaults to private deliberately: unaudited YouTube API projects reportedly
# have uploads locked to private regardless, and a surprise public upload is
# worse than a surprise private one. Flip this once you know where you stand
# on the YouTube API Services compliance audit.
YOUTUBE_PRIVACY_STATUS=private

# v27.0 is what Meta's docs use as of 2026-11-15.
GRAPH_API_VERSION=v27.0

# How often the publish worker looks for due posts. Creating a post that is
# due now nudges the worker immediately, so this is really how fast it
# recovers after a restart.
SCHEDULER_POLL_SECONDS=5

# If a scheduled time is missed by more than this many minutes — laptop
# asleep, server down — the post is failed with an explanation instead of
# being published late without warning. Set to 0 to always publish late.
SCHEDULER_MAX_CATCHUP_MINUTES=60
